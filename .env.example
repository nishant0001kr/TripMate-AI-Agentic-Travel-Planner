# Required for the LLM agents. ChatGPT Plus does not provide this API key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Required only by the matching live-data agent.
TAVILY_API_KEY=
AVIATION_STACK_API_KEY=
OPENWEATHER_API_KEY=

# Optional for local development. Without this value, state is kept in memory.
# DATABASE_URL=postgresql://user:password@localhost:5432/tripmate
